# ===========================================
# 환경변수 설정 파일 예시
# ===========================================
# 이 파일을 복사하여 .env.local 파일을 생성하세요:
#   cp .env.example .env.local (Linux/Mac)
#   copy .env.example .env.local (Windows)
#
# 그 후 실제 값으로 교체하세요.
# ===========================================

# -----------------------------------------
# Database 설정 (Prisma용, 로컬 PostgreSQL)
# -----------------------------------------
# 비밀번호의 특수문자는 URL 인코딩 필요 (@ → %40, ` → %60)
DATABASE_URL="postgresql://wbsmaster:your_password_here@127.0.0.1:5432/wbsmaster"

# 마이그레이션용 (prisma.config.ts) - 보통 DATABASE_URL과 동일
DIRECT_URL="postgresql://wbsmaster:your_password_here@127.0.0.1:5432/wbsmaster"

# -----------------------------------------
# 업로드 파일 저장 폴더 (선택사항, 기본: <프로젝트>/uploads)
# -----------------------------------------
# UPLOAD_DIR=C:\data\wbsmaster-uploads

# -----------------------------------------
# Slack 설정 (선택사항)
# -----------------------------------------
# Slack Webhook URL (Task 완료 알림용)
# Slack App 설정에서 Incoming Webhook URL을 생성하세요
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
